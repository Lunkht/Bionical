# --- Développement local (HTTP) ---
COOKIE_SECURE=false
TRUST_PROXY=false
BASE_URL=http://localhost:3000
# Avec "docker compose --profile dev up", les e-mails arrivent dans Mailpit (http://localhost:8025)
SMTP_URL=smtp://mailpit:1025

# --- Production (exemple) ---
# COOKIE_SECURE=true
# TRUST_PROXY=true
# BASE_URL=https://bionical.com
# SMTP_URL=smtp://utilisateur:motdepasse@mail.bionical.com:587   # votre serveur SMTP auto-hébergé
# MAIL_FROM="Bionical <no-reply@bionical.com>"
# CONTACT_TO=contact@bionical.com
